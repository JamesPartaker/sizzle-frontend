# Live Go API by default. Set demo explicitly for browser-local fixtures.
VITE_DATA_SOURCE=api
# Go API origin; permit both frontend and editor origins in credentialed CORS.
VITE_API_BASE_URL=http://localhost:1323
# Assets support the Go API independently of the other prototype data services.
# Set to api to enable private uploads/listing. Blank follows VITE_DATA_SOURCE.
VITE_ASSET_SOURCE=
# Optional Go asset origin override; otherwise uses VITE_API_BASE_URL.
VITE_ASSET_API_BASE_URL=
# Optional editor URL; documentId is appended as a query parameter.
VITE_EDITOR_URL=http://localhost:1234
# Account pages default to demo mode. Use api for the Go cookie-session endpoints.
VITE_AUTH_SOURCE=api
# Optional override for auth only; defaults to VITE_API_BASE_URL, then this origin.
VITE_AUTH_API_BASE_URL=
