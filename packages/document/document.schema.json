{
  "type": "object",
  "properties": {
    "format": {
      "const": "sizzle.document"
    },
    "version": {
      "const": 1
    },
    "layoutStatus": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "renderProfile": {
      "$ref": "#/$defs/renderProfile"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      },
      "maxProperties": 1000
    },
    "fonts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/font"
      },
      "maxProperties": 1000
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      },
      "maxProperties": 10000
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "editorState": {
      "$ref": "#/$defs/editorState"
    }
  },
  "required": [
    "format",
    "version",
    "layoutStatus",
    "renderProfile",
    "metadata",
    "resources",
    "fonts",
    "pages",
    "nodes",
    "extensions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "layoutStatus": {
            "const": "ready"
          }
        },
        "required": [
          "layoutStatus"
        ]
      },
      "then": {
        "properties": {
          "nodes": {
            "additionalProperties": {
              "if": {
                "properties": {
                  "type": {
                    "const": "text"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "text": {
                    "properties": {
                      "layout": {
                        "$ref": "#/$defs/textLayout"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
